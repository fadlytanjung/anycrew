{
  "name": "anycrew",
  "version": "0.1.1",
  "description": "One crew of specialist AI agents for any coding assistant. Spec-driven, test-first, security-reviewed, and model-tiered. Installs into Claude Code, OpenAI Codex, Google Antigravity, Gemini CLI, Cursor, OpenCode and GitHub Copilot.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "anycrew": "bin/anycrew.mjs"
  },
  "files": [
    "bin",
    "lib",
    "agents",
    "skills",
    "rules",
    "templates",
    "presets",
    "hooks",
    "models.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node scripts/validate.mjs && node scripts/smoke.mjs",
    "list": "node bin/anycrew.mjs list",
    "test:parity": "python3 tests/test_parity.py",
    "bump": "node scripts/bump.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "antigravity",
    "gemini-cli",
    "cursor",
    "opencode",
    "copilot",
    "agent-skills",
    "spec-driven-development",
    "boilerplate",
    "mvp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fadlytanjung/anycrew.git"
  }
}
