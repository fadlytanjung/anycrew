{
  "$comment": "anycrew:generated — Claude Code plugin hooks. Lints the file an agent just edited and feeds problems back.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lint-after-edit.sh\"",
            "timeout": 60,
            "statusMessage": "Linting edited file…"
          }
        ]
      }
    ]
  }
}
